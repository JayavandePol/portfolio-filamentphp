import { Head, router } from '@inertiajs/react';
import { motion } from 'framer-motion';
import { Filter, X } from 'lucide-react';
import { useState } from 'react';
import AppLayout from '../Layouts/AppLayout';
import ProjectCard from '../Components/ProjectCard';
import { cn } from '../lib/utils';

export default function Projects({ projects, categories, selectedCategory }) {
    const [isFilterOpen, setIsFilterOpen] = useState(false);

    const handleCategoryFilter = (categorySlug) => {
        if (categorySlug === selectedCategory) {
            // Clear filter if clicking the same category
            router.get('/projects', {}, { preserveState: true, preserveScroll: true });
        } else {
            router.get('/projects', { category: categorySlug }, { preserveState: true, preserveScroll: true });
        }
        setIsFilterOpen(false);
    };

    const clearFilter = () => {
        router.get('/projects', {}, { preserveState: true, preserveScroll: true });
    };
    return (
        <AppLayout>
            <Head title="Projects" />

            <div className="min-h-screen py-24">
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    {/* Header */}
                    <div className="mb-16 space-y-4">
                        <motion.h1
                            className="text-4xl md:text-5xl font-bold text-foreground"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                        >
                            Projects
                        </motion.h1>
                        <motion.p
                            className="text-lg text-muted-foreground max-w-2xl"
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            transition={{ delay: 0.1 }}
                        >
                            Explore my recent work and side projects. From web applications to design experiments.
                        </motion.p>
                    </div>

                    {/* Filter Section */}
                    {categories && categories.length > 0 && (
                        <motion.div
                            initial={{ opacity: 0, y: 20 }}
                            animate={{ opacity: 1, y: 0 }}
                            transition={{ delay: 0.2 }}
                            className="mb-8"
                        >
                            <div className="flex flex-wrap items-center gap-3">
                                <button
                                    onClick={() => setIsFilterOpen(!isFilterOpen)}
                                    className="inline-flex items-center gap-2 px-4 py-2 bg-card border border-border/50 rounded-lg text-foreground hover:border-electric/50 transition-colors"
                                >
                                    <Filter className="w-4 h-4" />
                                    Filter by Category
                                </button>

                                {selectedCategory && (
                                    <button
                                        onClick={clearFilter}
                                        className="inline-flex items-center gap-2 px-4 py-2 bg-electric/10 text-electric border border-electric/50 rounded-lg hover:bg-electric/20 transition-colors"
                                    >
                                        <span className="text-sm font-medium">
                                            {categories.find(cat => cat.slug === selectedCategory)?.name}
                                        </span>
                                        <X className="w-4 h-4" />
                                    </button>
                                )}
                            </div>

                            {isFilterOpen && (
                                <motion.div
                                    initial={{ opacity: 0, height: 0 }}
                                    animate={{ opacity: 1, height: 'auto' }}
                                    exit={{ opacity: 0, height: 0 }}
                                    className="mt-4 p-4 bg-card border border-border/50 rounded-lg"
                                >
                                    <div className="flex flex-wrap gap-2">
                                        {categories.map((category) => (
                                            <button
                                                key={category.id}
                                                onClick={() => handleCategoryFilter(category.slug)}
                                                className={cn(
                                                    'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                                                    selectedCategory === category.slug
                                                        ? 'bg-electric text-background border border-electric'
                                                        : 'bg-secondary border border-border/50 text-foreground hover:border-electric/50'
                                                )}
                                                style={selectedCategory === category.slug ? {} : { 
                                                    borderColor: `${category.color}30`,
                                                }}
                                            >
                                                <span className="flex items-center gap-2">
                                                    <span 
                                                        className="w-2 h-2 rounded-full"
                                                        style={{ backgroundColor: category.color }}
                                                    />
                                                    {category.name}
                                                </span>
                                            </button>
                                        ))}
                                    </div>
                                </motion.div>
                            )}
                        </motion.div>
                    )}

                    {/* Projects Grid */}
                    {projects && projects.length > 0 ? (
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {projects.map((project, index) => (
                                <ProjectCard 
                                    key={project.id} 
                                    project={project} 
                                    index={index}
                                />
                            ))}
                        </div>
                    ) : (
                        <motion.div
                            className="text-center py-24"
                            initial={{ opacity: 0 }}
                            animate={{ opacity: 1 }}
                        >
                            <p className="text-muted-foreground text-lg">
                                No projects available at the moment.
                            </p>
                        </motion.div>
                    )}
                </div>
            </div>
        </AppLayout>
    );
}
